# ==========================================
# EVERY DROP HAS A DECISION - ENVIRONMENT CONFIG
# ==========================================

# Active Data Layer ('local_reactive' or 'supabase')
VITE_DATA_LAYER=local_reactive

# Supabase Credentials (Optional for cloud production deployment)
# If left blank, the high-fidelity local reactive single-source-of-truth layer is automatically used.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Regional Emergency Coordinates Center (Vijayawada default)
VITE_CENTER_LAT=16.5062
VITE_CENTER_LNG=80.6480
